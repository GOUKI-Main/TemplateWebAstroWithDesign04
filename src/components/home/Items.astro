---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import SectionHead from "../ui/SectionHead.astro";
import wheat from "../../assets/images/deco/wheat.webp";
import sparkR from "../../assets/images/deco/spark_r.webp";

// 商品・メニューの並び。白い台紙に番号の赤丸、下に名前と一言。
// 6点（広い画面で1列6枚）が基本。3〜4点なら cols を 3 / 4 に。
type Item = { name: string; desc: string; image: ImageMetadata };
type Props = {
  heading: string;
  en?: string;
  items: Item[];
  /** 下に置く「すべて見る」ボタン。 */
  link?: { label: string; en?: string; href: string };
  id?: string;
};
const { heading, en, items, link, id = "items" } = Astro.props;
const cols =
  items.length >= 6
    ? "lg:grid-cols-6"
    : items.length === 4
      ? "lg:grid-cols-4"
      : "lg:grid-cols-3";
---

<section
  id={id}
  class="deco-clip relative bg-surface py-14 sm:py-[70px] sm:pb-[86px]"
>
  <Image
    src={wheat}
    alt=""
    class="pointer-events-none absolute top-[60px] left-[2%] hidden w-[70px] opacity-70 sm:block"
    data-pop
  />
  <Image
    src={sparkR}
    alt=""
    class="anim-twinkle pointer-events-none absolute top-[74px] right-[3%] hidden w-[88px] opacity-80 sm:block"
    data-pop
  />
  <div class="container-page">
    <SectionHead heading={heading} en={en} />
    <ul
      class:list={[
        "m-0 grid list-none grid-cols-2 gap-x-3.5 gap-y-8 p-0 sm:grid-cols-3 sm:gap-x-4 lg:gap-[18px]",
        cols,
      ]}
      data-reveal-child
    >
      {
        items.map((item, i) => (
          <li class="lift relative text-center">
            <div class="card relative px-3.5 pt-6 pb-4">
              <span
                class="en absolute -top-3 left-1/2 flex h-8 w-8 -translate-x-1/2 items-center justify-center rounded-full border-2 border-card bg-accent text-sm tracking-normal text-card shadow-[0_3px_7px_rgba(216,74,47,0.4)]"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <Image
                src={item.image}
                alt={item.name}
                widths={[240, 360]}
                sizes="(min-width: 1024px) 170px, (min-width: 640px) 30vw, 45vw"
                class="mx-auto h-[120px] w-full object-contain drop-shadow-[0_9px_9px_rgba(59,39,26,0.16)] sm:h-[130px] lg:h-[150px]"
              />
            </div>
            <h3 class="m-0 mt-4 text-base font-bold sm:text-[17px]">
              {item.name}
            </h3>
            <p class="m-0 mt-1.5 text-xs leading-[1.7] text-pretty text-muted">
              {item.desc}
            </p>
          </li>
        ))
      }
    </ul>
    {
      link && (
        <div class="mt-12 flex justify-center sm:mt-14" data-reveal>
          <a href={link.href} class="btn-pill">
            <span class="flex flex-col items-start">
              {link.label}
              {link.en && (
                <span class="en text-[0.56rem] opacity-70">{link.en}</span>
              )}
            </span>
            <span class="btn-arrow" aria-hidden="true">
              ▶
            </span>
          </a>
        </div>
      )
    }
  </div>
</section>

---
import { site } from "../content/site";
import { formatOpeningHours, formatTel } from "../lib/format";
import Logo from "./Logo.astro";

const { author, business: b } = site;
const year = new Date().getFullYear();

// Brand profiles (site.sameAs) first, then the author's own; de-duplicated so
// the same account listed in both places renders once. Adding a URL in
// site.ts is all it takes — the icon (or a text label) follows the host.
const LABELS: Record<string, string> = {
  "x.com": "X",
  "twitter.com": "X",
  "instagram.com": "Instagram",
  "facebook.com": "Facebook",
  "youtube.com": "YouTube",
  "tiktok.com": "TikTok",
  "line.me": "LINE",
  "lin.ee": "LINE",
  "note.com": "note",
  "github.com": "GitHub",
  "linkedin.com": "LinkedIn",
};
// 24×24 single-path marks, filled with currentColor.
const ICONS: Record<string, string> = {
  Instagram:
    "M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.8.25 2.23.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.42 2.23.06 1.3.07 1.68.07 4.9s0 3.6-.07 4.9c-.05 1.17-.25 1.8-.42 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.37-2.23.42-1.3.06-1.68.07-4.9.07s-3.6 0-4.9-.07c-1.17-.05-1.8-.25-2.23-.42a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.17-.42-.37-1.06-.42-2.23C2.21 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.05-1.17.25-1.8.42-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.42C8.4 2.21 8.8 2.2 12 2.2zm0 1.8c-3.15 0-3.5.01-4.74.07-.9.04-1.38.19-1.7.32-.43.16-.74.36-1.06.68-.32.32-.52.63-.68 1.06-.13.32-.28.8-.32 1.7C3.21 9.05 3.2 9.4 3.2 12s.01 2.95.07 4.19c.04.9.19 1.38.32 1.7.16.43.36.74.68 1.06.32.32.63.52 1.06.68.32.13.8.28 1.7.32 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c.9-.04 1.38-.19 1.7-.32.43-.16.74-.36 1.06-.68.32-.32.52-.63.68-1.06.13-.32.28-.8.32-1.7.06-1.24.07-1.59.07-4.19s-.01-2.95-.07-4.19c-.04-.9-.19-1.38-.32-1.7a2.85 2.85 0 0 0-.68-1.06 2.85 2.85 0 0 0-1.06-.68c-.32-.13-.8-.28-1.7-.32C15.5 4.01 15.15 4 12 4zm0 3.06A4.94 4.94 0 1 1 12 16.94 4.94 4.94 0 0 1 12 7.06zm0 8.14A3.2 3.2 0 1 0 12 8.8a3.2 3.2 0 0 0 0 6.4zm6.3-8.34a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0z",
  LINE: "M12 2.5C6.2 2.5 1.5 6.3 1.5 11c0 4.2 3.7 7.7 8.7 8.4.34.07.8.22.92.5.1.26.07.66.03.92l-.15.9c-.04.27-.21 1.05.92.57 1.13-.48 6.1-3.6 8.32-6.16C21.7 14.4 22.5 12.8 22.5 11c0-4.7-4.7-8.5-10.5-8.5zM7.3 13.6H5.2a.55.55 0 0 1-.55-.55V8.9a.55.55 0 0 1 1.1 0v3.6h1.55a.55.55 0 0 1 0 1.1zm2.16-.55a.55.55 0 0 1-1.1 0V8.9a.55.55 0 0 1 1.1 0v4.15zm5.04 0a.55.55 0 0 1-.38.52.6.6 0 0 1-.17.03.55.55 0 0 1-.44-.22l-2.12-2.88v2.55a.55.55 0 0 1-1.1 0V8.9a.55.55 0 0 1 .38-.52.55.55 0 0 1 .62.19l2.12 2.88V8.9a.55.55 0 0 1 1.1 0v4.15zm3.36-2.62a.55.55 0 0 1 0 1.1h-1.55v.97h1.55a.55.55 0 0 1 0 1.1h-2.1a.55.55 0 0 1-.55-.55V8.9a.55.55 0 0 1 .55-.55h2.1a.55.55 0 0 1 0 1.1h-1.55v.98h1.55z",
  X: "M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.78L17.75 3zm-1.08 16.17h1.7L7.4 4.74H5.58l11.09 14.43z",
  Facebook:
    "M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z",
  YouTube:
    "M23 7.2s-.2-1.6-.9-2.3c-.9-.9-1.9-.9-2.3-1C16.6 3.6 12 3.6 12 3.6s-4.6 0-7.8.3c-.5.1-1.5.1-2.3 1-.7.7-.9 2.3-.9 2.3S.7 9.1.7 11v1.8c0 1.9.3 3.8.3 3.8s.2 1.6.9 2.3c.9.9 2 .9 2.5 1 1.8.2 7.6.2 7.6.2s4.6 0 7.8-.3c.5-.1 1.5-.1 2.3-1 .7-.7.9-2.3.9-2.3s.3-1.9.3-3.8V11c0-1.9-.3-3.8-.3-3.8zM9.7 14.9V8.3l6.2 3.3-6.2 3.3z",
};
const labelFor = (url: string) => {
  const host = new URL(url).hostname.replace(/^www\./, "");
  return LABELS[host] ?? host;
};
const profiles = [
  ...new Set([
    ...(site.sameAs ?? []),
    ...(Object.values(author.socials ?? {}).filter(Boolean) as string[]),
  ]),
].map((url) => ({ url, label: labelFor(url) }));

// Page links: main nav, the header CTA, then policy pages.
const pageLinks = [
  ...site.nav,
  ...(site.cta && !site.cta.external ? [site.cta] : []),
  ...(site.footerNav ?? []),
];
const address = b?.address
  ? `〒${b.address.postalCode} ${b.address.addressRegion ?? ""}${b.address.addressLocality}${b.address.streetAddress}`
  : null;
---

<footer class="relative mt-auto bg-deep pt-14 pb-6 text-on-deep sm:pt-16">
  <a
    href="#top"
    class="tap-target absolute -top-7 right-4 h-[54px] w-[54px] flex-col rounded-full bg-card text-fg no-underline shadow-[0_8px_20px_rgba(0,0,0,0.3)] transition-transform hover:-translate-y-1 sm:right-8 sm:h-[62px] sm:w-[62px]"
    aria-label="ページの先頭へ"
  >
    <span class="text-xs leading-none" aria-hidden="true">▲</span>
    <span class="en text-xs font-bold">Top</span>
  </a>

  <div class="container-page">
    <div class="grid items-start gap-8 lg:grid-cols-[1.1fr_2fr] lg:gap-12">
      <div>
        <a href="/" class="tap-target" aria-label={`${site.name} ホーム`}>
          <Logo class="h-14 opacity-95 sm:h-16" onDeep />
        </a>
        {
          b && (
            <p class="mt-4 text-xs leading-[1.9] text-on-deep-muted">
              {address && (
                <>
                  {address}
                  <br />
                </>
              )}
              {b.telephone && (
                <>
                  TEL {formatTel(b.telephone)}
                  <br />
                </>
              )}
              {b.openingHours?.map(formatOpeningHours).join(" ／ ")}
              {b.closedDays && `（定休日：${b.closedDays}）`}
            </p>
          )
        }
      </div>

      <nav aria-label="フッターナビゲーション">
        <ul
          class="m-0 flex list-none flex-wrap gap-x-8 gap-y-1 p-0 sm:gap-x-10"
        >
          {
            pageLinks.map((link) => (
              <li>
                <a
                  class="tap-target text-sm font-medium text-on-deep/85 no-underline transition-colors hover:text-sun"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            author.email && (
              <li>
                <a
                  class="tap-target text-sm font-medium text-on-deep/85 no-underline transition-colors hover:text-sun"
                  href={`mailto:${author.email}`}
                >
                  メール
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col items-start gap-4 border-t border-on-deep/15 pt-5 sm:flex-row sm:items-center sm:justify-between"
    >
      {
        profiles.length > 0 && (
          <ul class="m-0 flex list-none flex-wrap gap-3 p-0">
            {profiles.map(({ url, label }) => (
              <li>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener"
                  aria-label={ICONS[label] ? label : undefined}
                  class="tap-target h-[42px] min-w-[42px] rounded-full bg-on-deep/10 px-3 text-xs font-bold text-on-deep no-underline transition hover:-translate-y-0.5 hover:bg-link"
                >
                  {ICONS[label] ? (
                    <svg
                      viewBox="0 0 24 24"
                      class="h-5 w-5 fill-current"
                      aria-hidden="true"
                    >
                      <path d={ICONS[label]} />
                    </svg>
                  ) : (
                    label
                  )}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {
        /* The rights holder is the business, not the person running the site. */
      }
      <p class="m-0 text-[0.7rem] text-on-deep-muted sm:ml-auto">
        {`© ${year} ${b?.legalName ?? site.name}`}
      </p>
    </div>
  </div>
</footer>

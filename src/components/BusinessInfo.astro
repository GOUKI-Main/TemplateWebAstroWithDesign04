---
import { site } from "../content/site";
import { formatOpeningHours, formatTel } from "../lib/format";

// Visible NAP (Name / Address / Phone) for local businesses. Renders only when
// site.business is set — the same single source that drives the LocalBusiness
// JSON-LD, so structured data and the visible text always match: the hours
// and phone are *derived* from the JSON-LD values (src/lib/format.ts), never
// typed twice. (§4 MEO)
const { showName = false } = Astro.props as {
  /** Print the business name above the table (pages other than the home). */
  showName?: boolean;
};
const b = site.business;
const address = b?.address;

const rows: { label: string; text?: string; tel?: string }[] = [];
if (b?.openingHours?.length)
  rows.push({
    label: "営業時間",
    text: b.openingHours.map(formatOpeningHours).join("\n"),
  });
if (b?.closedDays) rows.push({ label: "定休日", text: b.closedDays });
if (address)
  rows.push({
    label: "住所",
    text: `〒${address.postalCode}\n${address.addressRegion ?? ""}${address.addressLocality}${address.streetAddress}`,
  });
if (b?.telephone) rows.push({ label: "電話番号", tel: b.telephone });
for (const note of b?.notes ?? [])
  rows.push({ label: note.label, text: note.value });
---

{
  b && (
    <section class="not-prose" aria-label="店舗情報">
      {showName && (
        <p class="m-0 mb-2 font-bold text-fg">{b.legalName ?? site.name}</p>
      )}
      <dl class="m-0" data-reveal-child>
        {rows.map((row) => (
          <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-b border-dashed border-border py-3 text-[0.9rem] sm:grid-cols-[7.5rem_1fr]">
            <dt class="flex items-center gap-2 font-bold text-fg">
              <span
                class="h-[7px] w-[7px] flex-none rounded-full bg-accent"
                aria-hidden="true"
              />
              {row.label}
            </dt>
            <dd class="m-0 whitespace-pre-line text-muted">
              {row.tel ? (
                <a
                  class="tap-target text-muted hover:text-link"
                  href={`tel:${row.tel}`}
                >
                  {formatTel(row.tel)}
                </a>
              ) : (
                row.text
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

---
import type { SiteNavItem } from "../content/site";

// The nav link list, rendered twice by Header (mobile disclosure + desktop
// row). Active state is derived from the current path, not passed in, so the
// two copies can never disagree. Each link shows the Japanese label with an
// optional small English sub-label (site.nav[].en).
const { items, block = false } = Astro.props as {
  items: SiteNavItem[];
  /** Stacked, full-width tap targets (mobile menu) instead of an inline row. */
  block?: boolean;
};

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href.includes("#")
    ? false
    : href === "/"
      ? path === "/"
      : path === href || path.startsWith(`${href}/`);
---

<ul
  class:list={[
    "m-0 list-none p-0",
    block ? "flex flex-col" : "flex items-center gap-7",
  ]}
>
  {
    items.map((item) => {
      const active = isActive(item.href);
      return (
        <li class:list={[block && "border-b border-dashed border-border"]}>
          <a
            href={item.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "tap-target group relative gap-0.5 font-bold no-underline transition-colors hover:text-link",
              block
                ? "w-full flex-row justify-between gap-3 px-2 py-3 text-base"
                : "flex-col text-[0.94rem]",
              active ? "text-link" : "text-fg",
            ]}
          >
            <span>{item.label}</span>
            {item.en && (
              <span
                class:list={[
                  "en text-muted group-hover:text-link",
                  block ? "text-[0.65rem]" : "text-[0.56rem]",
                ]}
              >
                {item.en}
              </span>
            )}
            {active && !block && (
              <span
                class="absolute -bottom-2 left-1/2 h-1.5 w-1.5 -translate-x-1/2 rounded-full bg-accent"
                aria-hidden="true"
              />
            )}
          </a>
        </li>
      );
    })
  }
</ul>
